include *.md *.in *.toml *.yaml LICENSE NOTICE
recursive-include licenses *.txt
include requirements/requirements.txt requirements/rfdetr.txt requirements/faces.txt requirements/faces_gpu.txt
global-include pyppbox *.*
exclude .gitignore
recursive-exclude .git *.*
recursive-exclude .github *.*
recursive-exclude docs *.*
recursive-exclude examples *.*
prune plans
include tests/integration/gui_process_probe.py
global-exclude */__pycache__
global-exclude *.pyc *.cmd
